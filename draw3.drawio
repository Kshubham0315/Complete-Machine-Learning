ode data-end=&quot;11046&quot; data-start=&quot;11043&quot;&gt;C&lt;/code&gt;, &lt;code data-end=&quot;11051&quot; data-start=&quot;11048&quot;&gt;k&lt;/code&gt;).&lt;/p&gt;&lt;br&gt;&lt;hr data-end=&quot;11058&quot; data-start=&quot;11055&quot;&gt;&lt;br&gt;&lt;h3 data-end=&quot;11117&quot; data-start=&quot;11060&quot; data-section-id=&quot;7v0zgh&quot;&gt;Q2. Difference between Grid Search and Random Search?&lt;/h3&gt;&lt;br&gt;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot; tabindex=&quot;-1&quot;&gt;&lt;table class=&quot;w-fit min-w-(--thread-content-width)&quot; data-end=&quot;11318&quot; data-start=&quot;11119&quot;&gt;&lt;thead data-end=&quot;11150&quot; data-start=&quot;11119&quot;&gt;&lt;tr data-end=&quot;11150&quot; data-start=&quot;11119&quot;&gt;&lt;th class=&quot;last:pe-10&quot; data-col-size=&quot;sm&quot; data-end=&quot;11133&quot; data-start=&quot;11119&quot;&gt;Grid Search&lt;/th&gt;&lt;th class=&quot;last:pe-10&quot; data-col-size=&quot;sm&quot; data-end=&quot;11150&quot; data-start=&quot;11133&quot;&gt;Random Search&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-end=&quot;11318&quot; data-start=&quot;11184&quot;&gt;&lt;tr data-end=&quot;11239&quot; data-start=&quot;11184&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11210&quot; data-start=&quot;11184&quot;&gt;Tries every combination&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11239&quot; data-start=&quot;11210&quot;&gt;Tries random combinations&lt;/td&gt;&lt;/tr&gt;&lt;tr data-end=&quot;11266&quot; data-start=&quot;11240&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11256&quot; data-start=&quot;11240&quot;&gt;More accurate&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11266&quot; data-start=&quot;11256&quot;&gt;Faster&lt;/td&gt;&lt;/tr&gt;&lt;tr data-end=&quot;11318&quot; data-start=&quot;11267&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11276&quot; data-start=&quot;11267&quot;&gt;Slower&lt;/td&gt;&lt;td data-end=&quot;11318&quot; data-start=&quot;11276&quot; data-col-size=&quot;sm&quot;&gt;More efficient for large search spaces&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;hr data-end=&quot;11323&quot; data-start=&quot;11320&quot;&gt;&lt;br&gt;&lt;h3 data-end=&quot;11358&quot; data-start=&quot;11325&quot; data-section-id=&quot;x25tsg&quot;&gt;Q3. What is Cross Validation?&lt;/h3&gt;&lt;br&gt;&lt;p data-end=&quot;11505&quot; data-start=&quot;11360&quot;&gt;Cross Validation repeatedly splits the data into different training and validation sets to produce a more reliable estimate of model performance.&lt;/p&gt;&lt;br&gt;&lt;hr data-end=&quot;11510&quot; data-start=&quot;11507&quot;&gt;&lt;br&gt;&lt;h1 data-end=&quot;11538&quot; data-start=&quot;11512&quot; data-section-id=&quot;1na8p5m&quot;&gt;🎯 Module 10 Cheat Sheet&lt;/h1&gt;&lt;br&gt;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot; tabindex=&quot;-1&quot;&gt;&lt;table class=&quot;w-fit min-w-(--thread-content-width)&quot; data-end=&quot;11820&quot; data-start=&quot;11540&quot;&gt;&lt;thead data-end=&quot;11558&quot; data-start=&quot;11540&quot;&gt;&lt;tr data-end=&quot;11558&quot; data-start=&quot;11540&quot;&gt;&lt;th class=&quot;last:pe-10&quot; data-col-size=&quot;sm&quot; data-end=&quot;11547&quot; data-start=&quot;11540&quot;&gt;Tool&lt;/th&gt;&lt;th class=&quot;last:pe-10&quot; data-col-size=&quot;sm&quot; data-end=&quot;11558&quot; data-start=&quot;11547&quot;&gt;Purpose&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-end=&quot;11820&quot; data-start=&quot;11578&quot;&gt;&lt;tr data-end=&quot;11631&quot; data-start=&quot;11578&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11595&quot; data-start=&quot;11578&quot;&gt;&lt;code data-end=&quot;11594&quot; data-start=&quot;11580&quot;&gt;GridSearchCV&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11631&quot; data-start=&quot;11595&quot;&gt;Exhaustive hyperparameter search&lt;/td&gt;&lt;/tr&gt;&lt;tr data-end=&quot;11687&quot; data-start=&quot;11632&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11655&quot; data-start=&quot;11632&quot;&gt;&lt;code data-end=&quot;11654&quot; data-start=&quot;11634&quot;&gt;RandomizedSearchCV&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11687&quot; data-start=&quot;11655&quot;&gt;Random hyperparameter search&lt;/td&gt;&lt;/tr&gt;&lt;tr data-end=&quot;11730&quot; data-start=&quot;11688&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11710&quot; data-start=&quot;11688&quot;&gt;&lt;code data-end=&quot;11709&quot; data-start=&quot;11690&quot;&gt;cross_val_score()&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11730&quot; data-start=&quot;11710&quot;&gt;Cross Validation&lt;/td&gt;&lt;/tr&gt;&lt;tr data-end=&quot;11772&quot; data-start=&quot;11731&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11748&quot; data-start=&quot;11731&quot;&gt;&lt;code data-end=&quot;11747&quot; data-start=&quot;11733&quot;&gt;best_params_&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11772&quot; data-start=&quot;11748&quot;&gt;Best hyperparameters&lt;/td&gt;&lt;/tr&gt;&lt;tr data-end=&quot;11820&quot; data-start=&quot;11773&quot;&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11789&quot; data-start=&quot;11773&quot;&gt;&lt;code data-end=&quot;11788&quot; data-start=&quot;11775&quot;&gt;best_score_&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-end=&quot;11820&quot; data-start=&quot;11789&quot;&gt;Best cross-validation score&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;hr data-end=&quot;11825&quot; data-start=&quot;11822&quot;&gt;&lt;br&gt;&lt;h1 data-end=&quot;11848&quot; data-start=&quot;11827&quot; data-section-id=&quot;1lmq1dz&quot;&gt;🎉 Congratulations!&lt;/h1&gt;&lt;br&gt;&lt;p data-end=&quot;11911&quot; data-start=&quot;11850&quot;&gt;You have now completed the &lt;strong data-end=&quot;11901&quot; data-start=&quot;11877&quot;&gt;Scikit-learn Roadmap&lt;/strong&gt; covering:&lt;/p&gt;&lt;br&gt;&lt;ul data-end=&quot;12123&quot; data-start=&quot;11913&quot;&gt;&lt;br&gt;&lt;li data-end=&quot;11943&quot; data-start=&quot;11913&quot; data-section-id=&quot;ocp6t5&quot;&gt;&lt;br&gt;✅ Introduction &amp;amp; ML Workflow&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-end=&quot;11966&quot; data-start=&quot;11944&quot; data-section-id=&quot;1ufcvbl&quot;&gt;&lt;br&gt;✅ Data Preprocessing&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
